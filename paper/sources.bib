@article{mora1998,
title = {Particle size distribution analysis of coarse aggregate using digital image processing},
journal = {Cement and Concrete Research},
volume = {28},
number = {6},
pages = {921-932},
year = {1998},
issn = {0008-8846},
doi = {https://doi.org/10.1016/S0008-8846(98)00043-X},
url = {https://www.sciencedirect.com/science/article/pii/S000888469800043X},
author = {C.F. Mora and A.K.H. Kwan and H.C. Chan},
abstract = {An attempt at applying the digital image processing (DIP) technique to analyze the particle size distribution of coarse aggregate is made. Three different types of aggregates have been analyzed, and their grading curves are compared to those obtained by conventional mechanical sieving. Because DIP produces only area gradation and uses a particle size definition different from the square sieve size used in mechanical sieving, direct comparison is not possible unless the gradation basis and particle size definitions of the two methods are aligned. For this purpose, a simple method of converting the area gradation to mass gradation is proposed. Moreover, a size correction factor is used to convert the particle sizes measured by DIP to equivalent square sieve sizes so that comparison between the DIP and mechanical sieving results can be made. The study demonstrates that DIP is a fast, convenient, versatile, and accurate technique for particle size distribution analysis. It is, however, not without limitations, which will be discussed.}
}
